{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowJs": true,
    "checkJs": false,
    "noEmit": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "types": [
      "chrome",
      "jest",
      "node"
    ],
    "strict": true,
    "noImplicitAny": true,
    "strictNullChecks": true,
    "noImplicitThis": true,
    "baseUrl": ".",
    "paths": {
      "@common/*": [
        "features/common/*"
      ],
      "@tracker/*": [
        "features/tracker/*"
      ],
      "@dashboard/*": [
        "features/dashboard/*"
      ]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.js"
  ],
  "exclude": [
    "node_modules",
    "build",
    "tests",
    "coverage",
    "backup",
    "*.config.js",
    "tests/test_opt.js"
  ]
}